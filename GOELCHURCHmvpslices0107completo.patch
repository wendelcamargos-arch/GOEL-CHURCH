+      body: SafeArea(
+        child: ListView(
+          padding: const EdgeInsets.all(24),
+          children: [
+            Text(devotional.title, style: textTheme.headlineSmall),
+            if (devotional.author != null) ...[
+              const SizedBox(height: 4),
+              Text(devotional.author!, style: textTheme.labelLarge),
