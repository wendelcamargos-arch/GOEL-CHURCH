+  group('DailyVerseSelector', () {
+    test('mesmo dia resolve o mesmo versículo', () {
+      final d = DateTime(2026, 7, 25);
+      expect(
+        DailyVerseSelector.pick(verses, d).reference,
+        DailyVerseSelector.pick(verses, d).reference,
+      );
